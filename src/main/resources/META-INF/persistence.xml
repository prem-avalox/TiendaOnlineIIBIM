<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
	<persistence-unit name="persistencia">
	<provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
	<class>modelo.entidades.Bolsa</class>
	<class>modelo.entidades.ItemBolsa</class>
	<class>modelo.entidades.Prenda</class>
	<class>modelo.entidades.StockTalla</class>
	<class>modelo.entidades.Usuario</class>	
		<properties>
			<property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3307/tienda_online"/>
			<property name="jakarta.persistence.jdbc.user" value="root"/>
			<property name="jakarta.persistence.jdbc.password" value=""/>
			<property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
			
		    
			<!-- Configuración de generación de esquema -->
			<!-- IMPORTANTE: Usar 'none' para NO borrar datos existentes -->
			<property name="eclipselink.ddl-generation" value="none" />
			
			<!-- 
			<property name="eclipselink.ddl-generation" value="drop-and-create-tables" />
			<property name="eclipselink.ddl-generation" value="create-tables" />
			-->
			
			<!-- Logging SQL para debug -->
			<property name="eclipselink.logging.level.sql" value="FINE"/>
			<property name="eclipselink.logging.parameters" value="true"/>
			
			<!-- ✅ Deshabilitar cache completamente para evitar problemas de consistencia -->
			<property name="eclipselink.cache.shared.default" value="false"/>
			<property name="eclipselink.query-results-cache" value="false"/>
			<property name="eclipselink.query-results-cache.type" value="NONE"/>
			
		</properties>
	</persistence-unit>
</persistence>
